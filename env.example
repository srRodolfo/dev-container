# Nome base para todos os containers
CONTAINER_NAME=dev_container

# UID/GID para evitar problemas de permissão com volumes
PUID=1000
PGID=1000

# PHP
PHP_PORT=9000
PHP_VERSION=8.5

# Node
NODE_VERSION=24
NODE_PORT=3000
VITE_PORT=5173

# Apache
SERVER_PORT=8000

# MariaDB
DB_ROOT_PASSWORD=password
DB_PORT=3306
